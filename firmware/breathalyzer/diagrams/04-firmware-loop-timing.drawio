        <mxCell id="31" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="32" value="" style="html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="16" target="4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1245" /><mxPoint x="800" y="135" /></Array></mxGeometry></mxCell>
        <mxCell id="33" value="next record" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="806" y="1120" width="120" height="24" as="geometry" /></mxCell>
        <mxCell id="34" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="520" height="300" as="geometry" /></mxCell>
        <mxCell id="35" value="&lt;b&gt;Timing budget (estimate)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="480" height="26" as="geometry" /></mxCell>
        <mxCell id="36" value="readAveraged(): 25 samples at about 2 ms each" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="156" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="37" value="50–75 ms" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1240" y="156" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="38" value="delay(200)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="196" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="39" value="200 ms" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1240" y="196" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="40" value="SoftwareSerial TX, about 112 bytes at 10 bits each" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="236" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="41" value="≈117 ms" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1240" y="236" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="42" value="USB TX back-pressure (only when the buffer is full)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="276" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="43" value="0–50 ms" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1240" y="276" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="44" value="&lt;b&gt;Record period&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="316" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="45" value="&lt;b&gt;≈370–440 ms&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1240" y="316" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="46" value="&lt;b&gt;Records per second&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="356" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="47" value="&lt;b&gt;≈2.3–2.7&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1240" y="356" width="140" height="40" as="geometry" /></mxCell>
        <mxCell id="48" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="520" height="250" as="geometry" /></mxCell>
        <mxCell id="49" value="&lt;b&gt;EMA response&lt;/b&gt;&lt;br&gt;ema(n) = 0.75 · ema(n−1) + 0.25 · raw(n)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="480" height="50" as="geometry" /></mxCell>
        <mxCell id="50" value="50 % of a step reached" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="510" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="51" value="2.4 records (≈1 s)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1180" y="510" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="52" value="90 % of a step reached" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="53" value="8.0 records (≈3–3.5 s)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1180" y="550" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="54" value="Time constant τ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="55" value="3.5 records (≈1.3–1.5 s)" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1180" y="590" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="56" value="A breath peak shorter than about 1.5 s is attenuated and lagged by this filter." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="630" width="480" height="50" as="geometry" /></mxCell>
        <mxCell id="57" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="710" width="520" height="190" as="geometry" /></mxCell>
        <mxCell id="58" value="&lt;b&gt;What this means for the app&lt;/b&gt;&lt;br&gt;• The session peak is taken from the smoothed average (avg), not the raw sample.&lt;br&gt;• A gap of more than 3 s expires the live reading (MAX_BREATHALYZER_READING_AGE_MS = 3 000). The nominal period is about 0.4 s, so one late record is tolerated.&lt;br&gt;• Record size: 110 bytes plus CRLF for the README example (112 bytes in total)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="480" height="170" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
