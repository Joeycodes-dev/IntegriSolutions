  <diagram id="b1d335857f8a8a44" name="Firmware loop and timing">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1340" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Firmware main loop and timing budget&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="Runs once per record in breathalyzer.ino. Timing figures are estimates from the sketch and AVR behaviour. Confirm them with serial timestamps before relying on them." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1360" height="44" as="geometry" /></mxCell>
        <mxCell id="4" value="&lt;b&gt;loop()&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="5" value="&lt;b&gt;readAveraged()&lt;/b&gt;&lt;br&gt;25 × analogRead(A0) with delay(2)&lt;br&gt;≈50–75 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="190" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="6" value="&lt;b&gt;ema = (3·ema + raw) / 4&lt;/b&gt;&lt;br&gt;integer smoothing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="7" value="&lt;b&gt;warming?&lt;/b&gt;&lt;br&gt;millis() − bootMs &amp;lt; 60 000" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="8" value="device peak&lt;br&gt;not updated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="395" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="9" value="&lt;b&gt;device peak&lt;/b&gt;&lt;br&gt;max(peak, ema)&lt;br&gt;−2 per record while ema &amp;lt; 250" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="10" value="&lt;b&gt;alarm latch&lt;/b&gt;&lt;br&gt;ema &amp;gt; 350 → alarm = true&lt;br&gt;alarm and ema &amp;lt; 330 → alarm = false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="600" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="11" value="&lt;b&gt;buzzer&lt;/b&gt;&lt;br&gt;not warming AND alarm → tone(D8, 2700)&lt;br&gt;otherwise noTone(D8)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="720" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="12" value="&lt;b&gt;convert&lt;/b&gt;&lt;br&gt;vout = raw × 5 / 1023&lt;br&gt;rs = 1000 × (5 − vout) / vout&lt;br&gt;−1 when vout ≤ 0.05 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="820" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="13" value="&lt;b&gt;snprintf JSON line&lt;/b&gt;&lt;br&gt;+ CRLF, about 102–112 bytes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="930" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="14" value="&lt;b&gt;HC06Serial.write(line)&lt;/b&gt;&lt;br&gt;SoftwareSerial, blocking&lt;br&gt;≈117 ms at 9600 baud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1020" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="15" value="&lt;b&gt;Serial.write(line)&lt;/b&gt;&lt;br&gt;USB debug copy. Blocks only&lt;br&gt;when the 64-byte TX buffer is full" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1120" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="16" value="&lt;b&gt;delay(200)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1220" width="240" height="50" as="geometry" /></mxCell>
