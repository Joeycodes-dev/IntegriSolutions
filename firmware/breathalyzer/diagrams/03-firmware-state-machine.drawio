  <diagram id="4e4fc346c4a7facd" name="Firmware state machine">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Firmware behaviour: warm-up gate and alarm latch&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="breathalyzer.ino · WARMUP_MS 60000 · ALARM_THRESHOLD 350 · ALARM_HYSTERESIS 20 (clears below 330) · ALARM_HOLD_MS 0. The two regions are independent. The buzzer sounds only when both are satisfied." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1360" height="44" as="geometry" /></mxCell>
        <mxCell id="4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9ca3af;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="640" height="420" as="geometry" /></mxCell>
        <mxCell id="5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9ca3af;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="680" height="420" as="geometry" /></mxCell>
        <mxCell id="6" value="&lt;b&gt;Region A: warm-up gate&lt;/b&gt; (JSON field &lt;i&gt;warm&lt;/i&gt;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="600" height="30" as="geometry" /></mxCell>
        <mxCell id="7" value="&lt;b&gt;Region B: alarm latch&lt;/b&gt; (JSON fields &lt;i&gt;over&lt;/i&gt;, &lt;i&gt;alarm&lt;/i&gt;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="740" y="140" width="640" height="30" as="geometry" /></mxCell>
        <mxCell id="8" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="70" y="282" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="9" value="&lt;b&gt;WARMING&lt;/b&gt;&lt;br&gt;warm = true&lt;br&gt;Peak not updated&lt;br&gt;Buzzer forced off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="10" value="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;warm = false&lt;br&gt;Device peak tracked&lt;br&gt;Buzzer follows the latch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="11" value="after 60 s&lt;br&gt;since boot" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="340" y="244" width="100" height="40" as="geometry" /></mxCell>
        <mxCell id="12" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="740" y="282" width="16" height="16" as="geometry" /></mxCell>
        <mxCell id="13" value="&lt;b&gt;CLEAR&lt;/b&gt;&lt;br&gt;alarm = false&lt;br&gt;over = ema &amp;gt; 350 is reported" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="230" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="14" value="&lt;b&gt;LATCHED&lt;/b&gt;&lt;br&gt;alarm = true&lt;br&gt;Held while ema ≥ 330" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="230" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="15" value="enter: ema &amp;gt; 350&lt;br&gt;lastOverMs = now" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="16" value="leave: ema &amp;lt; 330&lt;br&gt;(hold 0 ms)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="980" y="352" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="17" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="18" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="19" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="20" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.2667;exitDx=0;exitDy=0;entryX=0.0;entryY=0.2667;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="21" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.0;exitY=0.7333;exitDx=0;exitDy=0;entryX=1.0;entryY=0.7333;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="22" value="&lt;b&gt;What changes at READY&lt;/b&gt;&lt;br&gt;• The buzzer may sound, but only while latched.&lt;br&gt;• Device peak starts tracking: peak = max(peak, ema). It decays by 2 counts per record while ema &amp;lt; 250.&lt;br&gt;• Records carry warm = false, and the app accepts them into the session peak.&lt;br&gt;60 s is a UI gate, not a stabilisation test. The datasheet preheat is over 24 hours." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="600" height="160" as="geometry" /></mxCell>
        <mxCell id="23" value="&lt;b&gt;Latch rules&lt;/b&gt;&lt;br&gt;• Entering LATCHED: ema &amp;gt; 350 (ALARM_THRESHOLD, raw ADC counts).&lt;br&gt;• Leaving LATCHED: ema &amp;lt; 330 (ALARM_THRESHOLD − ALARM_HYSTERESIS) with the hold satisfied. The hold is 0 ms, so the latch clears immediately.&lt;br&gt;• The latch also runs during WARMING. Only the buzzer is suppressed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="640" height="160" as="geometry" /></mxCell>
        <mxCell id="24" value="&lt;b&gt;Buzzer and flags (truth table)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1360" height="30" as="geometry" /></mxCell>
        <mxCell id="25" value="&lt;b&gt;Warm-up region&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="26" value="&lt;b&gt;Alarm region&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="290" y="616" width="230" height="40" as="geometry" /></mxCell>
        <mxCell id="27" value="&lt;b&gt;Buzzer on D8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="616" width="210" height="40" as="geometry" /></mxCell>
        <mxCell id="28" value="&lt;b&gt;JSON warm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="616" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="29" value="&lt;b&gt;JSON alarm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="616" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="30" value="&lt;b&gt;What the app does with it&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="616" width="370" height="40" as="geometry" /></mxCell>
        <mxCell id="31" value="WARMING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="250" height="56" as="geometry" /></mxCell>
        <mxCell id="32" value="CLEAR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="656" width="230" height="56" as="geometry" /></mxCell>
        <mxCell id="33" value="off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="656" width="210" height="56" as="geometry" /></mxCell>
        <mxCell id="34" value="true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="656" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="35" value="false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="656" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="36" value="Shows Warming. Capture is refused until warm clears." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="656" width="370" height="56" as="geometry" /></mxCell>
        <mxCell id="37" value="WARMING" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="250" height="56" as="geometry" /></mxCell>
        <mxCell id="38" value="LATCHED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="712" width="230" height="56" as="geometry" /></mxCell>
        <mxCell id="39" value="off (suppressed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="712" width="210" height="56" as="geometry" /></mxCell>
        <mxCell id="40" value="true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="712" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="41" value="true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="712" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="42" value="Alarm is reported, but warm samples never enter the session peak." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="712" width="370" height="56" as="geometry" /></mxCell>
        <mxCell id="43" value="READY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="768" width="250" height="56" as="geometry" /></mxCell>
        <mxCell id="44" value="CLEAR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="768" width="230" height="56" as="geometry" /></mxCell>
        <mxCell id="45" value="off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="768" width="210" height="56" as="geometry" /></mxCell>
        <mxCell id="46" value="false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="47" value="false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="768" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="48" value="Normal measurement. Session peak can rise." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="768" width="370" height="56" as="geometry" /></mxCell>
        <mxCell id="49" value="READY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="824" width="250" height="56" as="geometry" /></mxCell>
        <mxCell id="50" value="LATCHED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="824" width="230" height="56" as="geometry" /></mxCell>
        <mxCell id="51" value="on: tone(D8, 2700 Hz)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="824" width="210" height="56" as="geometry" /></mxCell>
        <mxCell id="52" value="false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="824" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="53" value="true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="824" width="150" height="56" as="geometry" /></mxCell>
        <mxCell id="54" value="Buzzer sounds. The THRESHOLD and ALARM chips show. Clean-air baseline is refused." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="824" width="370" height="56" as="geometry" /></mxCell>
        <mxCell id="55" value="Driver: &lt;i&gt;tone(8, 2700)&lt;/i&gt; when on and &lt;i&gt;noTone(8)&lt;/i&gt; when off (PASSIVE_BUZZER = true). The sound cannot be tuned or silenced from the app. The firmware reports the flags and never reads commands." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="904" width="1360" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
