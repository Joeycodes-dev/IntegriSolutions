  <diagram id="afc788987ca92fe5" name="Hardware wiring">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Breathalyzer hardware wiring (as implemented in breathalyzer.ino)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="5 V Arduino Uno or Nano. MQ-3 on A0, passive buzzer on D8, HC-06 SPP on D3 (RX) and D4 (TX through the 1 kΩ / 2 kΩ divider). Native USB stays on D0 and D1. Board and pin labels follow the ZS-040 silk-screen." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1400" height="44" as="geometry" /></mxCell>
        <mxCell id="4" value="&lt;b&gt;+5 V net&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="1400" height="20" as="geometry" /></mxCell>
        <mxCell id="5" value="&lt;b&gt;GND net: common ground for every board and module&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;fillColor=#1f2937;strokeColor=#1f2937;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="1400" height="20" as="geometry" /></mxCell>
        <mxCell id="6" value="MQ-3 sensor module (4-pin breakout)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="320" height="260" as="geometry" /></mxCell>
        <mxCell id="7" value="VCC · 5 V" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="220" y="180" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="8" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="220" y="220" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="9" value="AO → A0 (analogue)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="220" y="300" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="10" value="DO · not used" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="220" y="340" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="11" value="Passive buzzer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="320" height="130" as="geometry" /></mxCell>
        <mxCell id="12" value="+ · from D8" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="220" y="500" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="13" value="− · GND" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="14" value="&lt;b&gt;Arduino Uno / Nano&lt;/b&gt;&lt;br&gt;ATmega328P · 5 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=bottom;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="300" height="560" as="geometry" /></mxCell>
        <mxCell id="15" value="5 V" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="16" value="D3 · SoftwareSerial RX" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="300" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="17" value="D4 · SoftwareSerial TX" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="420" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="18" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="19" value="A0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="300" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="20" value="D8 · buzzer" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="500" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="21" value="&lt;b&gt;HC-06 module&lt;/b&gt;&lt;br&gt;ZS-040 / FC-114" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=bottom;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="300" height="620" as="geometry" /></mxCell>
        <mxCell id="22" value="VCC · 3.6–6 V" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="160" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="23" value="TXD (module out)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="24" value="RXD (3.3 V in)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="420" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="25" value="GND" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="26" value="EN · leave open" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="580" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="27" value="STATE · unused" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="640" width="120" height="40" as="geometry" /></mxCell>
        <mxCell id="28" value="1 kΩ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="100" height="40" as="geometry" /></mxCell>
        <mxCell id="29" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1035" y="435" width="10" height="10" as="geometry" /></mxCell>
        <mxCell id="30" value="2 kΩ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="1010" y="480" width="60" height="80" as="geometry" /></mxCell>
        <mxCell id="31" value="" style="html=1;rounded=0;strokeColor=#d79b00;strokeWidth=3;endArrow=none;endSize=8;exitX=0.6667;exitY=0.0;exitDx=0;exitDy=0;entryX=0.1714;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="32" value="" style="html=1;rounded=0;strokeColor=#d79b00;strokeWidth=3;endArrow=none;endSize=8;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5143;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="33" value="" style="html=1;rounded=0;strokeColor=#d79b00;strokeWidth=3;endArrow=none;endSize=8;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.8286;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="22" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="34" value="" style="html=1;rounded=0;strokeColor=#4b5563;strokeWidth=3;endArrow=none;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="35" value="" style="html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="36" value="" style="html=1;rounded=0;strokeColor=#4b5563;strokeWidth=3;endArrow=none;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.4643;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="18" target="5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="240" /></Array></mxGeometry></mxCell>
        <mxCell id="37" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="38" value="" style="html=1;rounded=0;strokeColor=#4b5563;strokeWidth=3;endArrow=none;endSize=8;exitX=0.6667;exitY=1.0;exitDx=0;exitDy=0;entryX=0.1714;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="39" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="23" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="40" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=none;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="17" target="28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="41" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="28" target="24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="42" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=none;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="29" target="30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="43" value="" style="html=1;rounded=0;strokeColor=#4b5563;strokeWidth=3;endArrow=none;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.7;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="30" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="44" value="" style="html=1;rounded=0;strokeColor=#4b5563;strokeWidth=3;endArrow=none;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8857;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="25" target="5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="45" value="&lt;b&gt;Level shift (mandatory)&lt;/b&gt;&lt;br&gt;D4 → 1 kΩ → RXD&lt;br&gt;RXD → 2 kΩ → GND&lt;br&gt;5 V × 2 k / 3 k ≈ 3.33 V&lt;br&gt;Never wire D4 straight to RXD. A 5 V signal can damage the 3.3 V module." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="140" width="220" height="150" as="geometry" /></mxCell>
        <mxCell id="46" value="&lt;b&gt;HC-06 power&lt;/b&gt;&lt;br&gt;VCC from the 5 V net only. The module accepts 3.6–6 V.&lt;br&gt;Never from 3V3.&lt;br&gt;EN: leave open unless the exact board requires a 3.3 V level. Never 5 V." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="310" width="220" height="150" as="geometry" /></mxCell>
        <mxCell id="47" value="&lt;b&gt;Decoupling (recommended)&lt;/b&gt;&lt;br&gt;100 nF ceramic and 10–100 µF electrolytic across HC-06 VCC and GND, close to the module." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1480" y="480" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="48" value="&lt;b&gt;Power budget&lt;/b&gt;&lt;br&gt;MQ-3 heater: 33 Ω ±5%, so about 150 mA at 5 V. Datasheet heating consumption: under 750 mW.&lt;br&gt;HC-06: about 30–50 mA (README).&lt;br&gt;Plan for at least 250 mA on the 5 V source, plus margin." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="620" width="220" height="180" as="geometry" /></mxCell>
        <mxCell id="49" value="&lt;b&gt;Buzzer&lt;/b&gt;&lt;br&gt;Passive buzzer on D8, driven by tone(2700 Hz).&lt;br&gt;AVR I/O pin: 20 mA recommended, 40 mA absolute maximum. Use a transistor driver if the buzzer draws more." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1480" y="820" width="220" height="120" as="geometry" /></mxCell>
        <mxCell id="50" value="Wire colours: orange = +5 V · dark grey = ground · blue = UART or digital drive · purple = analogue sensor signal · red = level-shift element. Dashed pins are not connected." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1400" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
