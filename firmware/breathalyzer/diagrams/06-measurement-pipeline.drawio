  <diagram id="a2117d47aac09df7" name="Measurement pipeline">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Measurement chain: ADC count to BAC estimate&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1440" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="Implemented in apps/mobile/src/services/breathalyzer.ts. Default profile mq3-default-v1: RL 1000 Ω · R0 7532 Ω · 0.45 mg/L at ratio 1 · slope −0.70 · clean-air ratio 60 · 0.21 g/100 mL per mg/L (2100:1 breath-to-blood)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1440" height="44" as="geometry" /></mxCell>
        <mxCell id="4" value="&lt;b&gt;1 · ADC count&lt;/b&gt;&lt;br&gt;raw = mean of 25 samples&lt;br&gt;range 0–1023 (10-bit)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="5" value="&lt;b&gt;2 · Voltage&lt;/b&gt;&lt;br&gt;V = raw × 5 / 1023&lt;br&gt;MQ3_VCC = 5 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="130" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="6" value="&lt;b&gt;3 · Sensor resistance&lt;/b&gt;&lt;br&gt;Rs = RL × (5 − V) / V&lt;br&gt;RL = 1000 Ω (must match module)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="532" y="130" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="7" value="&lt;b&gt;4 · Ratio to clean air&lt;/b&gt;&lt;br&gt;ratio = Rs / R0 × 60&lt;br&gt;R0 = 7532 Ω (baseline)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="778" y="130" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="8" value="&lt;b&gt;5 · Concentration&lt;/b&gt;&lt;br&gt;mg/L = 0.45 × ratio&lt;sup&gt;−0.7&lt;/sup&gt;&lt;br&gt;power-law model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1024" y="130" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="9" value="&lt;b&gt;6 · BAC estimate&lt;/b&gt;&lt;br&gt;g/100 mL = mg/L × 0.21&lt;br&gt;breath-to-blood 2100:1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="130" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="10" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="11" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="12" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="13" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="14" value="" style="html=1;rounded=0;strokeColor=#1f2937;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="15" value="&lt;b&gt;Worked example: raw 872&lt;/b&gt; (the session peak in the device screenshot, PEAK BAC 0.075)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1440" height="30" as="geometry" /></mxCell>
        <mxCell id="16" value="&lt;b&gt;872 counts&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="210" height="46" as="geometry" /></mxCell>
        <mxCell id="17" value="&lt;b&gt;4.262 V&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="286" y="306" width="210" height="46" as="geometry" /></mxCell>
        <mxCell id="18" value="&lt;b&gt;173 Ω&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="532" y="306" width="210" height="46" as="geometry" /></mxCell>
        <mxCell id="19" value="&lt;b&gt;1.379&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="778" y="306" width="210" height="46" as="geometry" /></mxCell>
        <mxCell id="20" value="&lt;b&gt;0.359 mg/L&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1024" y="306" width="210" height="46" as="geometry" /></mxCell>
        <mxCell id="21" value="&lt;b&gt;0.075 g/100 mL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="306" width="210" height="46" as="geometry" /></mxCell>
        <mxCell id="22" value="&lt;b&gt;Reference points (same profile)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1440" height="30" as="geometry" /></mxCell>
        <mxCell id="23" value="&lt;b&gt;ADC raw&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="150" height="36" as="geometry" /></mxCell>
        <mxCell id="24" value="&lt;b&gt;Meaning in the code or the policy&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="416" width="820" height="36" as="geometry" /></mxCell>
        <mxCell id="25" value="&lt;b&gt;Computed BAC (g/100 mL)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="416" width="470" height="36" as="geometry" /></mxCell>
        <mxCell id="26" value="120" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="27" value="Clean-air baseline for R0 = 7532 Ω (raw 119.9 under the default profile). The output is not zero." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="452" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="28" value="0.0054 (model floor)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="452" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="29" value="≈263" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="30" value="Datasheet detecting floor of 0.05 mg/L (Hanwei MQ-3). Below this the model extrapolates." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="492" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="31" value="0.0105" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="492" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="32" value="330" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="33" value="Firmware alarm clear level. ema below 330 releases the latch." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="532" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="34" value="0.0132" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="532" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="35" value="350" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="36" value="Firmware ALARM_THRESHOLD. ema above 350 latches the alarm and the buzzer." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="572" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="37" value="0.0140" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="572" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="38" value="≈475" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="39" value="Policy: professional driver limit 0.020 g/100 mL. Result is FAIL at or above the limit." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="612" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="40" value="0.0200" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="612" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="41" value="≈780" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="42" value="Policy: general driver limit 0.050 g/100 mL. Result is FAIL at or above the limit." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="652" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="43" value="0.0500" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="652" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="44" value="≈883" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="45" value="Console conversion-preview target for 0.080 g/100 mL." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="692" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="46" value="0.0803" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="692" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="47" value="1000" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="732" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="48" value="Top of the ADC range (Rs ≈ 23 Ω). Far outside any calibration." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="732" width="820" height="40" as="geometry" /></mxCell>
        <mxCell id="49" value="0.310" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="732" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="50" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;• The chain is a model. The constants (RL, R0, 0.45 mg/L at ratio 1, slope −0.70, clean-air ratio 60) are defaults. The mobile README says A and B must be fitted against a reference measurement. Until then the output is a screening estimate.&lt;br&gt;• A clean sensor does not read zero. The default profile gives about 0.005 g/100 mL in clean air. Re-running the clean-air baseline re-anchors R0 but leaves that floor in place.&lt;br&gt;• Policy (driverPolicy.ts): FAIL when BAC ≥ limit, otherwise PASS. Defaults are 0.050 (general) and 0.020 (professional) g/100 mL. Runtime configuration can override them." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1440" height="124" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
