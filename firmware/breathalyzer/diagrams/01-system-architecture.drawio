<mxfile host="app.diagrams.net" modified="2026-10-13T09:00:00.000Z" agent="OpenCode" version="26.0.0" type="device" compressed="false">
  <diagram id="d111424fef7341d3" name="System architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="940" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Breathalyzer subsystem — end-to-end architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="Firmware: breathalyzer.ino at commit 1d86a91. App: apps/mobile breathalyzer services and Android native module (no uncommitted changes in these files on 2026-10-13). Telemetry is one-way: the device accepts no commands." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1620" height="40" as="geometry" /></mxCell>
        <mxCell id="4" value="&lt;b&gt;1 · Sensor&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="36" as="geometry" /></mxCell>
        <mxCell id="5" value="&lt;b&gt;2 · Firmware (Arduino Uno / Nano)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="300" height="36" as="geometry" /></mxCell>
        <mxCell id="6" value="&lt;b&gt;3 · Bluetooth Classic link&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="110" width="250" height="36" as="geometry" /></mxCell>
        <mxCell id="7" value="&lt;b&gt;4 · Android app (apps/mobile)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="360" height="36" as="geometry" /></mxCell>
        <mxCell id="8" value="&lt;b&gt;5 · Records and backend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="300" height="36" as="geometry" /></mxCell>
        <mxCell id="9" value="&lt;b&gt;MQ-3 alcohol sensor module&lt;/b&gt;&lt;br&gt;SnO₂ sensing element, heater on 5 V&lt;br&gt;Analogue output AO → Arduino A0&lt;br&gt;Load resistor: firmware assumes RL = 1 kΩ&lt;br&gt;&lt;i&gt;verify on the physical module&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="250" height="150" as="geometry" /></mxCell>
        <mxCell id="10" value="&lt;b&gt;breathalyzer.ino&lt;/b&gt; (ATmega328P, 5 V)&lt;br&gt;Averages 25 ADC samples, 2 ms apart&lt;br&gt;EMA: ema = (3·ema + raw) / 4&lt;br&gt;60 s warm-up flag and device peak&lt;br&gt;Alarm latch: ADC above 350, clears below 330&lt;br&gt;One JSON line per record, CRLF terminated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="300" height="230" as="geometry" /></mxCell>
        <mxCell id="11" value="&lt;b&gt;Passive buzzer on D8&lt;/b&gt;&lt;br&gt;tone(2700 Hz) only when warm and latched" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="12" value="&lt;b&gt;USB serial on D0 / D1&lt;/b&gt;&lt;br&gt;Flashing and bench copy of the same stream" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="540" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="13" value="&lt;b&gt;HC-06 (ZS-040 / FC-114)&lt;/b&gt;&lt;br&gt;Bluetooth Classic SPP, 9600 baud, 8N1&lt;br&gt;Paired from Android Bluetooth settings&lt;br&gt;Slave: the phone opens the RFCOMM socket&lt;br&gt;The app sends no commands to it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="670" y="170" width="250" height="230" as="geometry" /></mxCell>
        <mxCell id="14" value="&lt;b&gt;Level shift&lt;/b&gt;&lt;br&gt;D4 → 1 kΩ → RXD and RXD → 2 kΩ → GND&lt;br&gt;5 V becomes ≈3.3 V" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="670" y="430" width="250" height="80" as="geometry" /></mxCell>
        <mxCell id="15" value="&lt;b&gt;Hc06BluetoothModule.java&lt;/b&gt; (native)&lt;br&gt;Bonded devices · RFCOMM SPP connect&lt;br&gt;512-byte reader thread&lt;br&gt;Hc06Data, Hc06Disconnected, Hc06Error events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="170" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="16" value="&lt;b&gt;breathalyzerBluetooth.ts&lt;/b&gt;&lt;br&gt;Name filter: HC-06, HC06S, ZS-040&lt;br&gt;Line assembler, 4 KB cap, events matched by MAC address" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="360" height="80" as="geometry" /></mxCell>
        <mxCell id="17" value="&lt;b&gt;BreathalyzerSession&lt;/b&gt; (breathalyzer.ts)&lt;br&gt;Parses JSON · session peak only when warm = false&lt;br&gt;3 s freshness gate · expireIfStale() every 1 s&lt;br&gt;capture() → BAC from the session peak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="360" height="110" as="geometry" /></mxCell>
        <mxCell id="18" value="&lt;b&gt;Breathalyser console&lt;/b&gt;&lt;br&gt;DeviceSettingsModal&lt;br&gt;Connect · Calibrate · Live" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="540" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="19" value="&lt;b&gt;Roadside test&lt;/b&gt;&lt;br&gt;OfficerDashboardScreen&lt;br&gt;Capture button" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="20" value="&lt;b&gt;On the phone, not the device:&lt;/b&gt; SecureStore holds preferences, the active calibration profile and the 20-entry calibration history" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="650" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="21" value="&lt;b&gt;Local SQLite queue&lt;/b&gt;&lt;br&gt;Test record and device evidence&lt;br&gt;pending_sync until uploaded" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="170" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="22" value="&lt;b&gt;Sync uploader&lt;/b&gt; (sync.ts)&lt;br&gt;Batches, retries, evidence uploads" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="23" value="&lt;b&gt;Backend API&lt;/b&gt; (backend/, Cloudflare Worker)&lt;br&gt;Data store: Supabase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="410" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="24" value="&lt;b&gt;Supervisor web app&lt;/b&gt; (apps/web)&lt;br&gt;Shows serial, calibration version and peak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="530" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="25" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3261;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="26" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="27" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5652;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5652;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="28" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.1957;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="29" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="30" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="31" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.2361;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="32" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.7639;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="17" target="19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="33" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="17" target="21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="455" /><mxPoint x="1340" y="210" /></Array></mxGeometry></mxCell>
        <mxCell id="34" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="21" target="22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="35" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="22" target="23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="36" value="" style="html=1;rounded=0;strokeColor=#2f6fab;strokeWidth=2;endArrow=block;endFill=1;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="23" target="24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="37" value="&lt;b&gt;iOS is not a supported target&lt;/b&gt;&lt;br&gt;HC-06 is Bluetooth Classic SPP. Standard iOS apps cannot open arbitrary Classic SPP links. On iOS, breathalyzerBluetooth.ts throws “HC-06 connectivity is supported by the Android app only.”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="520" height="120" as="geometry" /></mxCell>
        <mxCell id="38" value="&lt;b&gt;Screening prototype, not evidential&lt;/b&gt;&lt;br&gt;The MQ-3 output is uncalibrated. The default profile mq3-default-v1 is a model, not a validated BAC. The console copy “evidential reading” contradicts this and should be corrected." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="770" width="520" height="120" as="geometry" /></mxCell>
        <mxCell id="39" value="&lt;b&gt;Simulator is user-selected, never automatic&lt;/b&gt;&lt;br&gt;“Connect simulated MQ-3 device” is only started by a tap. The code has no fallback to it after an HC-06 failure. Production EAS builds still set EXPO_PUBLIC_BREATHALYZER_SIMULATION=1, which shows the option." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1140" y="770" width="520" height="120" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
