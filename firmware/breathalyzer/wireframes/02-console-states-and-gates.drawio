        <mxCell id="88" value="dashboard step = reading" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1024" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="89" value="The subject peak is locked while a roadside test is active." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="1024" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="90" value="&lt;b&gt;Disconnect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1064" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="91" value="dashboard step = reading" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="1064" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="92" value="Finish or cancel the current test before disconnecting the breathalyzer." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="1064" width="700" height="40" as="geometry" /></mxCell>
