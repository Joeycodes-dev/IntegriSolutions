        <mxCell id="2" value="&lt;b&gt;Console states and capture gates&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1480" height="40" as="geometry" /></mxCell>
        <mxCell id="3" value="Header states come from statusFromSnapshot() and buildSetupSteps(), so error and connecting states clear the live values. Gate messages are the exact alert and lock text in OfficerDashboardScreen.tsx and DeviceSettingsModal.tsx. The status hero, setup stepper and tab bar are shared by every tab." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1480" height="44" as="geometry" /></mxCell>
        <mxCell id="4" value="&lt;b&gt;A. Status hero states (each with its setup stepper)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="26" as="geometry" /></mxCell>
