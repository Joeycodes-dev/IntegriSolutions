        <mxCell id="67" value="&lt;b&gt;Condition in the code&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="736" width="480" height="36" as="geometry" /></mxCell>
        <mxCell id="68" value="&lt;b&gt;Message shown to the officer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="736" width="700" height="36" as="geometry" /></mxCell>
        <mxCell id="69" value="&lt;b&gt;Capture reading&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="70" value="connection ≠ connected, or readings = 0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="772" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="71" value="&lt;b&gt;No reading&lt;/b&gt;: Connect the breathalyzer and take a breath sample before capturing." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="772" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="72" value="&lt;b&gt;Capture reading&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="73" value="warm = true" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="812" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="74" value="&lt;b&gt;Sensor warming up&lt;/b&gt;: Wait for the breathalyzer to finish warming up before capturing a reading." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="812" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="75" value="&lt;b&gt;Capture reading&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="76" value="last sample older than 3 000 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="852" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="77" value="&lt;b&gt;Reading is stale&lt;/b&gt;: The breathalyzer has stopped sending live data. Reconnect it and take a fresh sample." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="852" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="78" value="&lt;b&gt;Capture reading&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="79" value="capture() returns null (no session peak, or BAC null)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="892" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="80" value="&lt;b&gt;No reading&lt;/b&gt;: No breath sample has been recorded yet. Blow into the breathalyzer until the reading stabilises." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="892" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="81" value="&lt;b&gt;Set clean-air baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="932" width="300" height="52" as="geometry" /></mxCell>
        <mxCell id="82" value="not connected or locked (button disabled). Otherwise the conversion is refused when the average is null, over or alarm is true, or Rs is out of range" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="932" width="480" height="52" as="geometry" /></mxCell>
        <mxCell id="83" value="&lt;b&gt;Baseline not updated&lt;/b&gt;: A stable clean-air reading is required. Keep the sensor away from alcohol vapour and wait for the live reading to settle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="932" width="700" height="52" as="geometry" /></mxCell>
        <mxCell id="84" value="&lt;b&gt;Apply profile, restore defaults&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="85" value="dashboard step = reading (lockDeviceMutations)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="340" y="984" width="480" height="40" as="geometry" /></mxCell>
        <mxCell id="86" value="Calibration is locked while a roadside test is active." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=6;strokeWidth=2;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="820" y="984" width="700" height="40" as="geometry" /></mxCell>
