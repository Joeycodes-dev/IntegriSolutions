        <mxCell id="95" value='&lt;span style="font-size:8px;color:#cbd5e1"&gt;Factory default. Not set on this phone yet.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=8;fontColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="736" y="698" width="120" height="36" as="geometry" /></mxCell>
        <mxCell id="96" value="&lt;b&gt;How to set it&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="530" y="740" width="330" height="18" as="geometry" /></mxCell>
        <mxCell id="97" value='&lt;b&gt;1&lt;/b&gt;  &lt;span style="font-size:10px;color:#475569"&gt;Take the breathalyser to clean, fresh air.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="530" y="758" width="330" height="16" as="geometry" /></mxCell>
        <mxCell id="98" value='&lt;b&gt;2&lt;/b&gt;  &lt;span style="font-size:10px;color:#475569"&gt;Wait until the status shows Ready.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="530" y="774" width="330" height="16" as="geometry" /></mxCell>
        <mxCell id="99" value='&lt;b&gt;3&lt;/b&gt;  &lt;span style="font-size:10px;color:#475569"&gt;Tap Set clean-air baseline.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="530" y="790" width="330" height="16" as="geometry" /></mxCell>
