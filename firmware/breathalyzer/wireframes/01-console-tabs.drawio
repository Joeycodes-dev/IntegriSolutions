        <mxCell id="103" value="Recalculate the sensor's clean-air resistance from a live sample." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="990" y="528" width="328" height="34" as="geometry" /></mxCell>
