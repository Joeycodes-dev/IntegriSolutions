        <mxCell id="109" value="&lt;b&gt;!&lt;/b&gt;  &lt;b&gt;Sensor warm-up&lt;/b&gt;  Waiting" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#92400e;" vertex="1" parent="1"><mxGeometry x="990" y="674" width="330" height="22" as="geometry" /></mxCell>
        <mxCell id="110" value="&lt;b&gt;Set clean-air baseline&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#e5e7eb;strokeColor=#d1d5db;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="990" y="696" width="330" height="30" as="geometry" /></mxCell>
        <mxCell id="111" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="976" y="746" width="358" height="224" as="geometry" /></mxCell>
        <mxCell id="112" value="&lt;b&gt;Measurement profile&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="990" y="756" width="300" height="22" as="geometry" /></mxCell>
        <mxCell id="113" value="Edit the MQ-3 conversion curve used to turn raw ADC into BAC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="990" y="778" width="328" height="34" as="geometry" /></mxCell>
        <mxCell id="114" value='&lt;span style="font-size:8px;color:#6b7280"&gt;LOAD RESISTANCE&lt;/span&gt;&lt;br&gt;&lt;b&gt;1,000 Ω&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="990" y="818" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="115" value='&lt;span style="font-size:8px;color:#6b7280"&gt;CLEAN-AIR RATIO&lt;/span&gt;&lt;br&gt;&lt;b&gt;60.0&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="818" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="116" value='&lt;span style="font-size:8px;color:#6b7280"&gt;MG/L AT RATIO 1&lt;/span&gt;&lt;br&gt;&lt;b&gt;0.450&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="990" y="864" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="117" value='&lt;span style="font-size:8px;color:#6b7280"&gt;CURVE SLOPE&lt;/span&gt;&lt;br&gt;&lt;b&gt;−0.70&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="864" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="118" value="&lt;b&gt;Apply measurement profile&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#1f2937;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="990" y="914" width="330" height="28" as="geometry" /></mxCell>
        <mxCell id="119" value="Restore default calibration" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#b91c1c;" vertex="1" parent="1"><mxGeometry x="990" y="948" width="330" height="16" as="geometry" /></mxCell>
        <mxCell id="120" value="&lt;b&gt;Calibrate rules&lt;/b&gt;&lt;br&gt;1. Set clean-air baseline needs a connected device, no roadside-test lock, a live average, and no over or alarm state. Otherwise the alert is “Baseline not updated”.&lt;br&gt;2. Apply measurement profile writes a new version (…+manual-stamp), logs test.device.calibrated, and adds a local history entry. History keeps 20 entries.&lt;br&gt;3. No role check is in DeviceSettingsModal, so any signed-in officer using the console can change the profile. Confirm whether that is intended.&lt;br&gt;4. Restore default calibration replaces the active profile with the repository defaults (mq3-default-v1). Locked during the roadside reading step." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="960" y="1000" width="390" height="270" as="geometry" /></mxCell>
        <mxCell id="121" value="&lt;b&gt;D · Activity tab&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=14;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1420" y="114" width="390" height="26" as="geometry" /></mxCell>
