        <mxCell id="73" value="&lt;b&gt;Disconnect breathalyzer&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#e5e7eb;strokeColor=#d1d5db;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="530" y="756" width="330" height="30" as="geometry" /></mxCell>
        <mxCell id="74" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="516" y="810" width="358" height="110" as="geometry" /></mxCell>
        <mxCell id="75" value="&lt;b&gt;Before a roadside test&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="530" y="820" width="300" height="22" as="geometry" /></mxCell>
        <mxCell id="76" value="Open Activity for the complete readiness check." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="530" y="842" width="328" height="34" as="geometry" /></mxCell>
        <mxCell id="77" value="&lt;b&gt;Open complete live activity&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#1f2937;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="530" y="862" width="330" height="34" as="geometry" /></mxCell>
        <mxCell id="78" value="⌄ Device tools (calibration, diagnostic report) continue below" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="500" y="940" width="390" height="20" as="geometry" /></mxCell>
        <mxCell id="79" value="&lt;b&gt;Device rules&lt;/b&gt;&lt;br&gt;1. Disconnect asks “Disconnect breathalyzer?” when Confirm before disconnect is on. The dialog warns that live telemetry stops and the subject peak is cleared.&lt;br&gt;2. While the roadside test is in its reading step, Disconnect is disabled and labelled “Locked during test”.&lt;br&gt;3. Closing the console does not disconnect the device. The session is shared with the roadside test.&lt;br&gt;4. Share a breathalyser diagnostic report exports text (firmware note, calibration, readiness, custody counts). It does not capture a reading." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="1000" width="390" height="270" as="geometry" /></mxCell>
