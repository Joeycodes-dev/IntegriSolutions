        <mxCell id="139" value="Calibrate" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1615.0" y="448" width="97.5" height="26" as="geometry" /></mxCell>
        <mxCell id="140" value="&lt;b&gt;Activity&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1712.5" y="448" width="97.5" height="26" as="geometry" /></mxCell>
        <mxCell id="141" value="" style="rounded=0;html=1;fillColor=#1f2937;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1730.5" y="482" width="61.5" height="3" as="geometry" /></mxCell>
        <mxCell id="142" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1436" y="496" width="358" height="300" as="geometry" /></mxCell>
        <mxCell id="143" value="&lt;b&gt;Capture readiness&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="506" width="300" height="22" as="geometry" /></mxCell>
        <mxCell id="144" value="All checks must pass before an evidential reading is captured." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="1450" y="528" width="328" height="34" as="geometry" /></mxCell>
        <mxCell id="145" value='&lt;b&gt;Device connection&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#6b7280"&gt;Connect an HC-06 or simulated device.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="546" width="280" height="40" as="geometry" /></mxCell>
        <mxCell id="146" value="&lt;b&gt;WAIT&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=none;fontFamily=Helvetica;fontSize=9;fontColor=#92400e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1738" y="555" width="48" height="22" as="geometry" /></mxCell>
        <mxCell id="147" value='&lt;b&gt;Live telemetry stream&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#6b7280"&gt;Waiting for a fresh device sample.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="590" width="280" height="40" as="geometry" /></mxCell>
        <mxCell id="148" value="&lt;b&gt;WAIT&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=none;fontFamily=Helvetica;fontSize=9;fontColor=#92400e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1738" y="599" width="48" height="22" as="geometry" /></mxCell>
        <mxCell id="149" value='&lt;b&gt;Sensor warm-up&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#6b7280"&gt;Wait for the MQ-3 warm-up flag to clear.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="634" width="280" height="40" as="geometry" /></mxCell>
        <mxCell id="150" value="&lt;b&gt;WAIT&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=none;fontFamily=Helvetica;fontSize=9;fontColor=#92400e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1738" y="643" width="48" height="22" as="geometry" /></mxCell>
        <mxCell id="151" value='&lt;b&gt;Breath sample&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#6b7280"&gt;Blow steadily into the sensor to create a sample.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="678" width="280" height="40" as="geometry" /></mxCell>
        <mxCell id="152" value="&lt;b&gt;WAIT&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=none;fontFamily=Helvetica;fontSize=9;fontColor=#92400e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1738" y="687" width="48" height="22" as="geometry" /></mxCell>
        <mxCell id="153" value='&lt;b&gt;Session peak&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px;color:#6b7280"&gt;The first non-warm sample becomes the session peak.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="722" width="280" height="40" as="geometry" /></mxCell>
        <mxCell id="154" value="&lt;b&gt;WAIT&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=none;fontFamily=Helvetica;fontSize=9;fontColor=#92400e;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1738" y="731" width="48" height="22" as="geometry" /></mxCell>
        <mxCell id="155" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1436" y="810" width="358" height="150" as="geometry" /></mxCell>
        <mxCell id="156" value="&lt;b&gt;Live telemetry&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1450" y="820" width="300" height="22" as="geometry" /></mxCell>
        <mxCell id="157" value="Read-only values from the firmware stream." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="1450" y="842" width="328" height="34" as="geometry" /></mxCell>
        <mxCell id="158" value='&lt;span style="font-size:8px;color:#6b7280"&gt;RAW ADC&lt;/span&gt;&lt;br&gt;&lt;b&gt;744&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1450" y="866" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="159" value='&lt;span style="font-size:8px;color:#6b7280"&gt;SMOOTHED AVG&lt;/span&gt;&lt;br&gt;&lt;b&gt;639&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="866" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="160" value='&lt;span style="font-size:8px;color:#6b7280"&gt;DEVICE PEAK&lt;/span&gt;&lt;br&gt;&lt;b&gt;766&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1450" y="912" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="161" value='&lt;span style="font-size:8px;color:#6b7280"&gt;SESSION PEAK&lt;/span&gt;&lt;br&gt;&lt;b&gt;872&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=13;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1620" y="912" width="160" height="40" as="geometry" /></mxCell>
        <mxCell id="162" value="⌄ Signal voltage, sensor resistance, live and peak BAC, diagnostics, custody" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="1420" y="962" width="390" height="20" as="geometry" /></mxCell>
        <mxCell id="163" value="&lt;b&gt;Activity rules&lt;/b&gt;&lt;br&gt;1. Five readiness checks. Capture is refused unless the device is connected, warm-up is complete, the sample is fresh (3 s), and a session peak exists.&lt;br&gt;2. Run three second stream diagnostic passes with at least two samples in 3 s and a fresh sample. It is logged as test.device.diagnostic.&lt;br&gt;3. Reset subject peak clears the session peak and the sample count. Locked during the reading step.&lt;br&gt;4. Preview a test capture calculates BAC from the session peak (or average) and writes nothing. SIGNAL VOLTAGE uses raw; SENSOR RESISTANCE uses the smoothed average." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="1000" width="390" height="270" as="geometry" /></mxCell>
        <mxCell id="164" value="Key: solid dark button = primary action · outlined = secondary · grey dashed = simulator-only · disabled grey = blocked by a rule. Amber WAIT = check not yet passed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1800" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
