        <mxCell id="107" value="&lt;b&gt;!&lt;/b&gt;  &lt;b&gt;Device connection&lt;/b&gt;  Waiting" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#92400e;" vertex="1" parent="1"><mxGeometry x="990" y="630" width="330" height="22" as="geometry" /></mxCell>
