        <mxCell id="175" value="536" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=8;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="996" y="810" width="34" height="14" as="geometry" /></mxCell>
        <mxCell id="176" value="75" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=8;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="996" y="884" width="34" height="14" as="geometry" /></mxCell>
        <mxCell id="177" value="Smoothed device signal. Newest reading on the right." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="990" y="916" width="330" height="14" as="geometry" /></mxCell>
        <mxCell id="178" value="&lt;b&gt;Reset peak for next subject&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#1f2937;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="990" y="934" width="330" height="28" as="geometry" /></mxCell>
        <mxCell id="179" value="&amp;#9662; Device health and records continue below" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="960" y="966" width="390" height="20" as="geometry" /></mxCell>
        <mxCell id="180" value="&lt;b&gt;Live rules&lt;/b&gt;&lt;br&gt;1. The chart auto-scales to the visible range with a minimum span of 40 counts, so a few counts of change are as visible as a large swing. Bars are grey at rest, blue while rising, red over the alarm level, and the newest bar carries a dark dot.&lt;br&gt;2. The dashed line is the clean-air level for the active calibration. It is hidden when it sits more than 120 counts outside the visible range.&lt;br&gt;3. Reset peak for next subject clears the subject peak only. It no longer clears the reading count, so a late next record cannot expire the socket.&lt;br&gt;4. Technical readings, records on this phone and BAC limits are collapsed disclosures. Dry-run capture writes nothing." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="960" y="1140" width="390" height="290" as="geometry" /></mxCell>
        <mxCell id="181" value="Key: solid dark button = primary action &amp;#183; outlined = secondary &amp;#183; grey dashed = simulator-only &amp;#183; disabled grey = blocked by a rule. Green circle = step done, blue ring = in progress, amber text = waiting, dashed circle with Optional = recommended but not required." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="1800" height="24" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
