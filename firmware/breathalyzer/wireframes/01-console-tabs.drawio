        <mxCell id="105" value='&lt;span style="font-size:8px;color:#cbd5e1"&gt;ACTIVE CLEAN-AIR RESISTANCE&lt;/span&gt;&lt;br&gt;&lt;b&gt;7,532 Ω&lt;/b&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1004" y="570" width="220" height="48" as="geometry" /></mxCell>
