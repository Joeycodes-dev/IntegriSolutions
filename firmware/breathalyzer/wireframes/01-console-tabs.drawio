        <mxCell id="44" value="Check Bluetooth permissions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#1e40af;" vertex="1" parent="1"><mxGeometry x="70" y="768" width="330" height="20" as="geometry" /></mxCell>
