        <mxCell id="48" value="Paired with this phone." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="70" y="872" width="328" height="18" as="geometry" /></mxCell>
        <mxCell id="49" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;" vertex="1" parent="1"><mxGeometry x="70" y="894" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="50" value="&lt;b&gt;HC-06&lt;/b&gt; &amp;#183; AA:BB:CC:DD:EE:FF" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=10;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="82" y="898" width="160" height="18" as="geometry" /></mxCell>
        <mxCell id="51" value="&lt;b&gt;SAVED&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=none;fontFamily=Helvetica;fontSize=9;fontColor=#1e40af;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="82" y="916" width="50" height="14" as="geometry" /></mxCell>
        <mxCell id="52" value="&lt;b&gt;Connect&lt;/b&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;strokeWidth=1.5;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#1f2937;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="310" y="902" width="80" height="26" as="geometry" /></mxCell>
        <mxCell id="53" value="Can't see your breathalyser?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="70" y="956" width="330" height="20" as="geometry" /></mxCell>
        <mxCell id="54" value="&lt;b&gt;Connect rules&lt;/b&gt;&lt;br&gt;1. Scan lists bonded devices only. The app does not run nearby discovery. Renamed modules are hidden behind the &amp;ldquo;Show all paired Bluetooth devices&amp;rdquo; toggle.&lt;br&gt;2. Reconnect automatically runs once when the console opens, and only if the saved device is still paired.&lt;br&gt;3. The HC-06 path is Android-only. Non-Android builds show the rehearsal note and the simulator instead.&lt;br&gt;4. Start simulated breathalyser shows only in dev builds or when EXPO_PUBLIC_BREATHALYZER_SIMULATION=1. The production EAS profile sets it." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;fontColor=#1f2937;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="390" height="290" as="geometry" /></mxCell>
