        <mxCell id="148" value='&lt;span style="font-size:8px;color:#6b7280"&gt;LIVE BAC ESTIMATE&lt;/span&gt;&lt;br&gt;&lt;b&gt;0.017 g/100ml&lt;/b&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;fontFamily=Helvetica;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="990" y="676" width="160" height="52" as="geometry" /></mxCell>
