        <mxCell id="65" value="Serial MQ3-SIM1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=9;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="530" y="318" width="210" height="16" as="geometry" /></mxCell>
