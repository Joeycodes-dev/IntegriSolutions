# Backend settings
PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: officer invite emails (Resend). Without these, invites still work via copyable link.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=IntegriScan <onboarding@resend.dev>
# OFFICER_INVITE_BASE_URL=integriscan://onboard
# SUPERVISOR_INVITE_BASE_URL=http://localhost:3000?supervisorInvite=1

# Optional: Google Cloud Vision OCR. If omitted, /api/scan falls back to Tesseract only.
# Prefer service-account credentials in production.
# GOOGLE_APPLICATION_CREDENTIALS=absolute-path-to-your-service-account-json-file.json
# GOOGLE_CLOUD_PROJECT_ID=your-google-account-project-id
# Or base64-encoded service-account JSON for hosted environments that reject raw JSON:
# GOOGLE_CLOUD_VISION_CREDENTIALS_BASE64=base64-encoded-service-account-json
# Or inline service-account JSON:
# GOOGLE_CLOUD_VISION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Or API key mode:
# GOOGLE_CLOUD_VISION_API_KEY=your-google-cloud-vision-api-key
